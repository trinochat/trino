<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Options for `xcodebuild -exportArchive` in .github/workflows/ios-tor-spike.yml,
     the same as the demo's apps/mobile/ios/ExportOptions.plist on feat/movil
     (the full list: `xcodebuild -help`). It signs the archive for App Store
     Connect with the team's cloud-managed Apple Distribution certificate,
     automatically, and uploads the build instead of writing an .ipa. -->
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>upload</string>
	<!-- Keep the build number the workflow gives (the run number). -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>3KD8QNQXH6</string>
</dict>
</plist>
