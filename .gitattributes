# SAS v2 (docs/sas-v2.md): the mobile app keeps byte-identical copies of the
# JSON files and the scripts rebuild them byte for byte, so these files are LF
# on every checkout, whatever core.autocrlf says.
/assets/sas/** text eol=lf
/docs/sas-v2.md text eol=lf
/scripts/gen-sas-assets.mjs text eol=lf
/scripts/gen-sas-assets.d.mts text eol=lf
/scripts/sas_vectors.py text eol=lf

# Arti's test consensus (crates/trino-net/tests/data) is parsed as it is, and
# the parser expects LF. The vendored crates stay byte for byte as published
# but for their patch.
/crates/trino-net/tests/data/** text eol=lf
/vendor/** text eol=lf

# Test certificates (crates/trino-net/src/testdata): DER bytes, never text.
/crates/trino-net/src/testdata/*.der binary

# Tor Browser's pt_config.json (the built-in bridges), byte for byte as the
# Expert Bundle ships it, and the script that refreshes it.
/crates/trino-net/src/tor/pt_config.json text eol=lf
/scripts/fetch-lyrebird.sh text eol=lf
/src-tauri/binaries/lyrebird.pin text eol=lf
